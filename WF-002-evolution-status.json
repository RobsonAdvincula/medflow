{
  "name": "MedFlow · WF-002 · Status em Tempo Real (Evolution API)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "medflow-status",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook-002",
      "name": "Webhook · Mudança de Status",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "medflow-status"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.status }}",
              "operation": "isNotEmpty"
            },
            {
              "value1": "={{ $json.body.atendimento_id }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "node-if-valido",
      "name": "IF · Payload Válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.status }}",
                    "rightValue": "em-atendimento",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "em-atendimento"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.status }}",
                    "rightValue": "concluido",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "concluido"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.status }}",
                    "rightValue": "cancelado",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "cancelado"
            }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      },
      "id": "node-switch-status",
      "name": "Switch · Tipo de Status",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [680, 240]
    },
    {
      "parameters": {
        "values": {
          "string": [
            { "name": "status_label", "value": "Em Atendimento 🟡" },
            { "name": "notificar", "value": "nao" }
          ]
        },
        "options": {}
      },
      "id": "node-set-em-atend",
      "name": "Set · Em Atendimento",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [900, 120]
    },
    {
      "parameters": {
        "values": {
          "string": [
            { "name": "status_label", "value": "Concluído 🟢" },
            { "name": "notificar", "value": "sim" },
            {
              "name": "mensagem_paciente",
              "value": "=Olá *{{ $('Webhook · Mudança de Status').item.json.body.paciente }}*! 😊\n\nSua consulta foi *concluída* com sucesso.\n\nObrigado pela preferência! Em caso de dúvidas ou para agendar um retorno, estamos à disposição.\n\n_MedFlow · Clínica_"
            }
          ]
        },
        "options": {}
      },
      "id": "node-set-concluido",
      "name": "Set · Concluído",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [900, 280]
    },
    {
      "parameters": {
        "values": {
          "string": [
            { "name": "status_label", "value": "Cancelado 🔴" },
            { "name": "notificar", "value": "sim" },
            {
              "name": "mensagem_paciente",
              "value": "=Olá *{{ $('Webhook · Mudança de Status').item.json.body.paciente }}*!\n\nInformamos que sua consulta de hoje foi *cancelada*.\n\nEntre em contato para reagendar:\n📞 {{ $vars.CLINICA_TELEFONE }}\n\n_MedFlow · Clínica_"
            }
          ]
        },
        "options": {}
      },
      "id": "node-set-cancelado",
      "name": "Set · Cancelado",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [900, 440]
    },
    {
      "parameters": {
        "url": "={{ $vars.MEDFLOW_API_URL }}/atendimentos/{{ $('Webhook · Mudança de Status').item.json.body.atendimento_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $vars.MEDFLOW_API_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"status\": \"{{ $('Webhook · Mudança de Status').item.json.body.status }}\",\n  \"medico\": \"{{ $('Webhook · Mudança de Status').item.json.body.medico }}\",\n  \"atualizado_em\": \"{{ new Date().toISOString() }}\",\n  \"origem\": \"n8n-wf-002\"\n}",
        "method": "PATCH",
        "options": {}
      },
      "id": "node-patch-status",
      "name": "HTTP PATCH · MedFlow API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1120, 280]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.notificar }}",
              "value2": "sim",
              "operation": "equals"
            }
          ]
        }
      },
      "id": "node-if-notif",
      "name": "IF · Notificar Paciente?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 460]
    },
    {
      "parameters": {
        "url": "={{ $vars.EVOLUTION_URL }}/message/sendText/{{ $vars.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $vars.EVOLUTION_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $('Webhook · Mudança de Status').item.json.body.telefone.replace(/[^0-9]/g, '') }}@s.whatsapp.net\",\n  \"textMessage\": {\n    \"text\": {{ JSON.stringify($json.mensagem_paciente) }}\n  },\n  \"options\": {\n    \"delay\": 1200,\n    \"presence\": \"composing\"\n  }\n}",
        "options": {}
      },
      "id": "node-evolution-notif",
      "name": "Evolution API · Notificar Paciente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1340, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"atendimento_id\": \"{{ $('Webhook · Mudança de Status').item.json.body.atendimento_id }}\",\n  \"novo_status\": \"{{ $('Webhook · Mudança de Status').item.json.body.status }}\",\n  \"timestamp\": \"{{ new Date().toISOString() }}\"\n}",
        "options": {}
      },
      "id": "node-respond-ok",
      "name": "Respond · OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1340, 220]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"success\": false, \"error\": \"Payload inválido\"}",
        "options": { "responseCode": 400 }
      },
      "id": "node-respond-invalido",
      "name": "Respond · Inválido",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [680, 460]
    }
  ],
  "connections": {
    "Webhook · Mudança de Status": {
      "main": [[{ "node": "IF · Payload Válido?", "type": "main", "index": 0 }]]
    },
    "IF · Payload Válido?": {
      "main": [
        [{ "node": "Switch · Tipo de Status", "type": "main", "index": 0 }],
        [{ "node": "Respond · Inválido", "type": "main", "index": 0 }]
      ]
    },
    "Switch · Tipo de Status": {
      "main": [
        [{ "node": "Set · Em Atendimento", "type": "main", "index": 0 }],
        [{ "node": "Set · Concluído", "type": "main", "index": 0 }],
        [{ "node": "Set · Cancelado", "type": "main", "index": 0 }]
      ]
    },
    "Set · Em Atendimento": {
      "main": [[{ "node": "HTTP PATCH · MedFlow API", "type": "main", "index": 0 }]]
    },
    "Set · Concluído": {
      "main": [
        [{ "node": "HTTP PATCH · MedFlow API", "type": "main", "index": 0 }],
        [{ "node": "IF · Notificar Paciente?", "type": "main", "index": 0 }]
      ]
    },
    "Set · Cancelado": {
      "main": [
        [{ "node": "HTTP PATCH · MedFlow API", "type": "main", "index": 0 }],
        [{ "node": "IF · Notificar Paciente?", "type": "main", "index": 0 }]
      ]
    },
    "HTTP PATCH · MedFlow API": {
      "main": [[{ "node": "Respond · OK", "type": "main", "index": 0 }]]
    },
    "IF · Notificar Paciente?": {
      "main": [
        [{ "node": "Evolution API · Notificar Paciente", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "timezone": "America/Sao_Paulo"
  },
  "tags": ["medflow", "evolution-api", "status", "clinica"],
  "_readme": {
    "descricao": "WF-002 · Atualiza status do atendimento e notifica paciente via Evolution API",
    "variaveis_n8n": {
      "EVOLUTION_URL": "http://localhost:8080 ou https://evolution.seudominio.com",
      "EVOLUTION_INSTANCE": "Nome da instância (ex: clinica-principal)",
      "EVOLUTION_API_KEY": "API Key global da Evolution API",
      "MEDFLOW_API_URL": "URL base da API MedFlow",
      "MEDFLOW_API_TOKEN": "Token Bearer MedFlow",
      "CLINICA_TELEFONE": "(11) 3333-4444"
    },
    "payload_esperado": {
      "atendimento_id": "ATD-2026-00341",
      "status": "em-atendimento | concluido | cancelado",
      "paciente": "Ana Silva",
      "telefone": "5511991234567",
      "medico": "Dr. Carlos Neto"
    }
  }
}
